#!/usr/bin/env python3
"""
static-prm-db:
    Generate deployment level parameter database helpers for static parameter databases
"""

import sys
from contextlib import nullcontext
from typing import TYPE_CHECKING

import fpp
import static_autocoder_common as common

if TYPE_CHECKING:
    import fprime_cpp_codegen as cg

#: Credited in the `\author` line of every generated file's banner
TOOL_NAME = "static-prm-db"

#: Annotation marking the component this autocoder generates parameter storage for. Must
#: match the `@` annotation on the component definition, e.g. Samd21.StaticPrmDb.
PRM_DB_ANNOTATION = "static-prm-db"


def generate(
    model: fpp.Model,
    topology: fpp.Topology,
    file_base: str,
) -> str:
    from fprime_cpp_codegen import CppDocBuilder, Output

    doc = CppDocBuilder(
        file_base,
        description=f"parameter database code for {topology.qualified_name}",
        tool_name=TOOL_NAME,
    )

    doc.system_include(
        "cstring",
        output=Output.CPP,
    )

    doc.include(
        f"{topology.name}TopologyAc.hpp",
        output=Output.CPP,
    )

    doc.include(
        "fprime-samd/Svc/Types/PrmRecord.hpp",
        output=Output.CPP,
    )

    doc.include(
        "samd-config/StaticPrmDbConfig.hpp",
        output=Output.CPP,
    )

    dictionary = model.analysis.dictionary_map[topology.symbol]

    for component in common.all_annotated_components(model, PRM_DB_ANNOTATION):
        generate_ac_functions(topology, component, dictionary, record_value_size(model), doc)

    return doc.render_cpp()


def encode_type(ty: fpp.Type.Variant) -> str:
    """Canonical encoding of everything about a type that affects how its stored bytes are read

    Type names, formats and defaults are left out: they don't change the meaning of a saved value.
    """
    match ty:
        case fpp.Type.Alias():
            # An alias is just another name for its target
            return encode_type(ty.alias_type)
        case fpp.Type.PrimitiveInt() | fpp.Type.Float():
            return ty.value.name
        case fpp.Type.Boolean():
            return "bool"
        case fpp.Type.String():
            # None means the framework default size, covered by the serialized size of the param
            return f"string[{ty.value}]"
        case fpp.Type.Enum():
            constants = []
            for c in ty.node.constants:
                match c.resolved_value:
                    case fpp.Value.EnumConstant(value=(name, value)):
                        constants.append(f"{name}={value}")
                    case other:
                        raise ValueError(
                            f"Unexpected value {other!r} for enum constant {c.name}"
                        )
            return f"enum:{ty.rep_type.name}{{{','.join(constants)}}}"
        case fpp.Type.Array():
            return encode_type(ty.anon_array)
        case fpp.Type.AnonArray():
            return f"[{ty.size}]{encode_type(ty.elt_type)}"
        case fpp.Type.Struct():
            # Struct members may themselves be arrays, recorded in `sizes`
            sizes = ty.sizes
            members = ",".join(
                (
                    f"{name}:[{sizes[name]}]{encode_type( mty)}"
                    if name in sizes
                    else f"{name}:{encode_type(mty)}"
                )
                for name, mty in ty.anon_struct.members
            )
            return f"struct{{{members}}}"
        case fpp.Type.AnonStruct():
            members = ",".join(f"{name}:{encode_type(mty)}" for name, mty in ty.members)
            return f"struct{{{members}}}"
        case _:
            raise ValueError(
                f"Cannot store parameters of type {ty!r} in a static parameter database"
            )


def crc16(data: bytes, crc: int = 0xFFFF) -> int:
    """CRC-16/CCITT-FALSE, matching Samd21::crc16 (PrmRecord.cpp)"""
    for byte in data:
        crc ^= byte << 8
        for _ in range(8):
            crc = ((crc << 1) ^ 0x1021) if (crc & 0x8000) else (crc << 1)
            crc &= 0xFFFF
    return crc


#: FPP constant giving the bytes of a parameter value held by one persistent record
#: (PrmRecord::VALUE_SIZE). Overridable per project, see Samd21StaticPrmDbConfig.fpp.
RECORD_VALUE_SIZE_CONSTANT = "Samd21.StaticPrmDbConfig.RECORD_VALUE_SIZE"


def record_value_size(model: fpp.Model) -> int:
    symbol = model.lookup(RECORD_VALUE_SIZE_CONSTANT, kind=fpp.Symbol.Constant)
    if symbol is None:
        raise fpp.DiagnosticError(
            fpp.Diagnostic(f"{RECORD_VALUE_SIZE_CONSTANT} is not defined (samd-config)")
        )
    value = model.analysis.get_int_value(symbol.definition.value)
    if value is None or value < 1:
        raise fpp.DiagnosticError(
            fpp.Diagnostic(
                f"{RECORD_VALUE_SIZE_CONSTANT} must be a positive integer, not {value!r}",
            )
        )
    return value

#: Record IDs never assigned to a parameter (PrmRecord::EMPTY_ID, PrmRecord::BLANK_ID)
RESERVED_RECORD_IDS = {0x0000: "an unused slot", 0xFFFF: "erased storage"}


def record_key(prm: fpp.ParamEntry, segment: int, value_size: int) -> str:
    """The text a record ID is the CRC-16 of

    The ID only depends on what the record holds: which parameter (by name, not by its ID, so
    renumbering instances keeps the stored values), how its bytes are read and which segment of
    them it holds (segment and value size together give its byte range). Any change that would
    make a saved record decode differently changes the ID, so a load skips records of an older
    dictionary or record size instead of misreading them.
    """
    return "%s.%s:%s:%d/%d" % (
        prm.instance.qualified_name,
        prm.param.name,
        encode_type(prm.param.param_type),
        segment,
        value_size,
    )


def generate_ac_functions(
    topology: fpp.Topology,
    component: fpp.Component,
    dictionary: fpp.Dictionary,
    value_size: int,
    doc: "cg.CppDocBuilder",
):
    import fprime_cpp_codegen as cg

    # The parameter storage is a single global holding every parameter in the topology,
    # so it can only back one instance
    if common.get_singleton_instance(topology, component) is None:
        # This component is not in the topology, we don't need to do anything
        return

    # Generate the above interface in the proper namespace/C++ class
    *namespaces, prm_db_name = component.symbol.qualified_name.split(".")

    # Sorted by ID: StaticPrmDb looks parameters up with a binary search
    params = sorted(dictionary.param_entry_map.items(), key=lambda entry: entry[0])

    def prm_name(p: fpp.ParamEntry) -> str:
        i_name = p.instance.qualified_name.replace(".", "_")
        return f"{i_name}_{p.param.name}"

    def diagnose(message: str, prm: fpp.ParamEntry) -> fpp.DiagnosticError:
        e = fpp.DiagnosticError(fpp.Diagnostic(message))
        e.diagnostic.add_annotation("from parameter", span=prm.param.node.span)
        e.diagnostic.add_annotation("in component instance", span=prm.instance.node.span)
        return e

    # Every parameter's validity bits sit in one 32-bit word, so a parameter is checked with a
    # single (word & mask) == mask. Records are numbered in parameter order for the save iterator.
    #   param:  (id, prm, member, size, segments, word, first bit)
    #   record: (record ID, param row, segment, key)
    param_rows = []
    record_rows = []
    record_owner: dict[int, tuple[fpp.ParamEntry, str]] = {}
    word, bit = 0, 0
    for id, prm in params:
        # Static sizes are assumed everywhere
        # Make sure none of our parameters are strings
        try:
            common.assert_fixed_width(
                prm.param.param_type,
                "Only fixed-width serializables are supported for static parameter database",
            )
        except fpp.DiagnosticError as e:
            e.diagnostic.add_annotation("from parameter", span=prm.param.node.span)
            e.diagnostic.add_annotation(
                "in component instance", span=prm.instance.node.span
            )
            raise

        size = prm.param.param_type.serialized_size
        if size == 0:
            raise diagnose("A stored parameter must have a non-empty value", prm)

        segments = (size + value_size - 1) // value_size
        if segments > 32:
            raise diagnose(
                f"A stored parameter can take at most 32 records ({32 * value_size} bytes with "
                f"{RECORD_VALUE_SIZE_CONSTANT} = {value_size}), not {size} bytes",
                prm,
            )
        if bit + segments > 32:
            word, bit = word + 1, 0
        row = (id, prm, prm_name(prm), size, segments, word, bit)
        param_rows.append(row)
        bit += segments

        for segment in range(segments):
            key = record_key(prm, segment, value_size)
            record_id = crc16(key.encode("utf-8"))
            if record_id in RESERVED_RECORD_IDS:
                raise diagnose(
                    f"Record ID 0x{record_id:04x} of '{key}' is reserved for "
                    f"{RESERVED_RECORD_IDS[record_id]}; rename the parameter",
                    prm,
                )
            if record_id in record_owner:
                other, other_key = record_owner[record_id]
                e = diagnose(
                    f"Record ID 0x{record_id:04x} of '{key}' collides with '{other_key}'; "
                    "rename one of the parameters",
                    prm,
                )
                e.diagnostic.add_annotation("colliding parameter", span=other.param.node.span)
                raise e
            record_owner[record_id] = (prm, key)
            record_rows.append((record_id, row, segment, key))

    num_params = len(param_rows)
    num_records = len(record_rows)
    validity_words = (word + 1) if param_rows else 0

    def mask(row) -> str:
        _, _, _, _, segments, _, first = row
        return "0x%08xU" % (((1 << segments) - 1) << first)

    def valid(row) -> str:
        w = row[5]
        return f"((__PRM_VALIDITY[{w}] & {mask(row)}) == {mask(row)})"

    def segment_span(row, segment: int) -> tuple[int, int]:
        start = segment * value_size
        return start, min(value_size, row[3] - start)

    # A topology need not sit inside a module, and namespace() rejects an empty name list
    scope = doc.namespace(*namespaces) if namespaces else nullcontext(doc)
    with scope as ns:
        ns.lines("// Persistent records (record ID = CRC-16 of the key)", output=cg.Output.CPP)
        ns.lines(
            "".join(f"|// 0x{rid:04x} {key}\n" for rid, _, _, key in record_rows),
            output=cg.Output.CPP,
        )

        members = "".join(
            f"|  U8 {member}[{size}];  // {prm.param.param_type} id=0x{id:x}\n"
            for id, prm, member, size, _, _, _ in param_rows
        )
        ns.lines(
            f"""
            |//! Records of the deployment
            |constexpr FwSizeType NUM_RECORDS = {num_records};
            |
            |// The persistent store must hold every record of the deployment
            |static_assert(NUM_RECORDS <= ::Samd21::StaticPrmDbConfig::STORE_RECORDS,
            |              "The deployment has {num_records} parameter records, more than StaticPrmDbConfig::STORE_RECORDS");
            |
            |// Record IDs and segment offsets below were generated for this record value size
            |static_assert(::Samd21::PrmRecord::VALUE_SIZE == {value_size},
            |              "PrmRecord::VALUE_SIZE does not match the RECORD_VALUE_SIZE static-prm-db generated for");
            |
            |//! Validity bits: one per record, a parameter's records share a word
            |U32 __PRM_VALIDITY[{max(validity_words, 1)}] = {{}};
            |
            |//! Serialized parameter values
            |struct {{
            {members}|}} __PRM_VALUES = {{}};
            |""",
            output=cg.Output.CPP,
        )

        # The switches only map an ID or index to constants; one shared helper per operation
        # does the work, so each case is a few argument loads and a branch
        ns.lines(
            f"""
            |//! A parameter's value and its validity bits in __PRM_VALIDITY[word]
            |static Fw::ParamValid readValue(const U8* value, FwSizeType size, FwSizeType word, U32 mask, Fw::ParamBuffer& val) {{
            |  if ((__PRM_VALIDITY[word] & mask) != mask) {{
            |    return Fw::ParamValid::INVALID;
            |  }}
            |  const Fw::SerializeStatus status = val.setBuff(value, size);
            |  FW_ASSERT(status == Fw::FW_SERIALIZE_OK, status);
            |  return Fw::ParamValid::VALID;
            |}}
            |
            |static void writeValue(U8* value, FwSizeType size, FwSizeType word, U32 mask, const Fw::ParamBuffer& val) {{
            |  FW_ASSERT(val.getSize() == size, static_cast<FwAssertArgType>(val.getSize()), static_cast<FwAssertArgType>(size));
            |  (void)::memcpy(value, val.getBuffAddr(), size);
            |  __PRM_VALIDITY[word] |= mask;
            |}}
            |
            |static {prm_db_name}::RecordLoad loadSegment(const U8* record, bool merge, U8* segment, FwSizeType length, FwSizeType word, U32 bit) {{
            |  if (merge && ((__PRM_VALIDITY[word] & bit) != 0)) {{
            |    return {prm_db_name}::RecordLoad::KEPT;
            |  }}
            |  (void)::memcpy(segment, &record[::Samd21::PrmRecord::VALUE_OFFSET], length);
            |  __PRM_VALIDITY[word] |= bit;
            |  return {prm_db_name}::RecordLoad::LOADED;
            |}}
            |
            |static bool saveSegment(U8* record, U16 recordId, const U8* segment, FwSizeType length, FwSizeType word, U32 mask) {{
            |  // Parameters without a valid value are left out: a load leaves them invalid
            |  if ((__PRM_VALIDITY[word] & mask) != mask) {{
            |    return false;
            |  }}
            |  ::Samd21::PrmRecord::pack(record, recordId, segment, length);
            |  return true;
            |}}""",
            output=cg.Output.CPP,
        )

        # Fw::ParamValid readParam(FwPrmIdType id, Fw::ParamBuffer& val);
        with ns.function(
            f"{prm_db_name} ::readParam", ret="Fw::ParamValid", static=True
        ) as f:
            f.param("FwPrmIdType", "id")
            f.param("Fw::ParamBuffer&", "val")
            with f.body.switch("id") as sw:
                for row in param_rows:
                    id, prm, member, size, _, w, _ = row
                    with sw.case(f"0x{id:x}") as c:
                        c.lines(f"""// {member}: {prm.param.param_type}
                        |return readValue(__PRM_VALUES.{member}, {size}, {w}, {mask(row)}, val);""")
                with sw.default() as d:
                    d.lines("""|FW_ASSERT(false, static_cast<FwAssertArgType>(id));
                               |return Fw::ParamValid::INVALID;""")

        # void writeParam(FwPrmIdType id, const Fw::ParamBuffer& val);
        with ns.function(f"{prm_db_name} ::writeParam", static=True) as f:
            f.param("FwPrmIdType", "id")
            f.param("const Fw::ParamBuffer&", "val")
            with f.body.switch("id") as sw:
                for row in param_rows:
                    id, prm, member, size, _, w, _ = row
                    with sw.case(f"0x{id:x}") as c:
                        c.lines(f"""// {member}: {prm.param.param_type}
                        |writeValue(__PRM_VALUES.{member}, {size}, {w}, {mask(row)}, val);
                        |break;""")
                with sw.default() as d:
                    d.lines("FW_ASSERT(false, static_cast<FwAssertArgType>(id));")

        # RecordLoad loadRecord(const U8* record, bool merge);
        with ns.function(
            f"{prm_db_name} ::loadRecord", ret=f"{prm_db_name}::RecordLoad", static=True
        ) as f:
            f.param("const U8*", "record")
            f.param("bool", "merge")
            with f.body.switch("::Samd21::PrmRecord::getId(record)") as sw:
                for rid, row, segment, key in sorted(record_rows, key=lambda r: r[0]):
                    member, w, first = row[2], row[5], row[6]
                    start, length = segment_span(row, segment)
                    b = "0x%08xU" % (1 << (first + segment))
                    with sw.case(f"0x{rid:04x}") as c:
                        c.lines(f"""// {key}
                        |return loadSegment(record, merge, &__PRM_VALUES.{member}[{start}], {length}, {w}, {b});""")
                with sw.default() as d:
                    # A parameter removed from (or retyped in) the dictionary since the store was saved
                    d.line("return RecordLoad::UNKNOWN;")

        # bool saveRecord(FwSizeType index, U8* record);
        with ns.function(f"{prm_db_name} ::saveRecord", ret="bool", static=True) as f:
            f.param("FwSizeType", "index")
            f.param("U8*", "record")
            if record_rows:
                with f.body.switch("index") as sw:
                    for index, (rid, row, segment, key) in enumerate(record_rows):
                        member, w = row[2], row[5]
                        start, length = segment_span(row, segment)
                        with sw.case(f"{index}") as c:
                            c.lines(f"""// {key}
                            |return saveSegment(record, 0x{rid:04x}, &__PRM_VALUES.{member}[{start}], {length}, {w}, {mask(row)});""")
                    with sw.default() as d:
                        d.lines("""|FW_ASSERT(false, static_cast<FwAssertArgType>(index));
                                   |return false;""")
            else:
                f.body.lines("""|(void)record;
                                |FW_ASSERT(false, static_cast<FwAssertArgType>(index));
                                |return false;""")

        with ns.function(f"{prm_db_name} ::invalidateAll", static=True) as f:
            f.body.line("(void)::memset(__PRM_VALIDITY, 0, sizeof(__PRM_VALIDITY));")

        with ns.function(f"{prm_db_name} ::countInvalidParams", ret="U32", static=True) as f:
            f.body.line("U32 invalid = 0;")
            for row in param_rows:
                f.body.line(f"invalid += {valid(row)} ? 0U : 1U;  // {row[2]}")
            f.body.line("return invalid;")

        with ns.function(f"{prm_db_name} ::numParams", ret="U32", static=True) as f:
            f.body.line(f"return {num_params};")

        with ns.function(f"{prm_db_name} ::numRecords", ret="FwSizeType", static=True) as f:
            f.body.line("return NUM_RECORDS;")

        with ns.function(f"{prm_db_name} ::loadParameters", static=True) as f:
            # Load parameters is generated for each deployment topology
            # This call is simply a wrapper call around that function
            # A topology outside any module has its loadParameters in the global namespace
            *namespaces, _ = topology.symbol.qualified_name.split(".")
            f.body.line(f"{"::".join(["", *namespaces, "loadParameters"])}();")


def main() -> int:
    return common.main(TOOL_NAME, generate)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except fpp.DiagnosticError as e:
        print(e.diagnostic.render(color=True))
        sys.exit(1)
